<Project>
  <!-- Paket mandiri Windows x64 yang menyertakan runtime .NET (PRD 23: tidak perlu memasang runtime). -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishDir>..\..\artifacts\RailNexus-win-x64\</PublishDir>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
