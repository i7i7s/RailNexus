<Window x:Class="RailNexus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RailNexus" Width="1440" Height="900" MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Sans}" FontSize="14"
        Foreground="{StaticResource Brush.Text}" Background="{StaticResource Brush.Bg}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigasi kiri -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Side}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16" LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,8,16">
                    <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource Brush.Accent}">
                        <Path Data="M8.5,21 L12.2,7 M19.5,21 L15.8,7 M9.6,16.5 L18.4,16.5 M10.9,11.8 L17.1,11.8"
                              Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>
                    <TextBlock Text="RailNexus" FontWeight="Bold" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Nav}" AutomationProperties.Name="Navigasi utama">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Button.Nav}" Margin="0,0,0,2"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding DisabledReason}"
                                    AutomationProperties.HelpText="{Binding DisabledReason}">
                                <TextBlock Text="{Binding Label}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Instalasi" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding ProfileLabel}" FontWeight="SemiBold" FontSize="13" Margin="0,4" TextWrapping="Wrap" />
                        <ContentControl Content="{Binding Connection}" Focusable="False" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Bar konteks atas -->
            <Border Grid.Row="0" MinHeight="68" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1" Padding="24,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Tanpa aset aktif: judul halaman. -->
                    <TextBlock Grid.Column="0" Text="{Binding CurrentPage.Title}" Style="{StaticResource Text.H2}" FontSize="18"
                               VerticalAlignment="Center"
                               Visibility="{Binding ActiveAsset, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                    <!-- Dengan aset aktif: nama, status, jenis, KUID. -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                Visibility="{Binding ActiveAsset, Converter={StaticResource VisibleWhen}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ActiveAsset.Entry.Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ContentControl Content="{Binding ActiveStatus}" Margin="8,0,0,0" Focusable="False" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center">
                                <Run Text="Kategori " /><Run Text="{Binding ActiveAsset.Entry.Category, Mode=OneWay}" /><Run Text=" · " />
                            </TextBlock>
                            <TextBlock x:Name="ActiveKuid" Text="{Binding ActiveAsset.Entry.Kuid, Mode=OneWay}" Style="{StaticResource Text.Mono}"
                                       VerticalAlignment="Center" />
                            <Button Style="{StaticResource Button.Link}" Content="Salin KUID" Margin="6,0,0,0" Click="CopyKuid_Click" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProfileLabel}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Border Style="{StaticResource Card}" Padding="10,4"
                                Visibility="{Binding ShowDraftPanel, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Draft.CountLabel}" FontSize="13" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Area kerja + ringkasan perubahan -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl Grid.Column="0" Content="{Binding CurrentPage}" Focusable="False" />
                <Border Grid.Column="1" Width="340" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1,0,0,0"
                        Visibility="{Binding ShowDraftPanel, Converter={StaticResource BoolToVisibility}}">
                    <ContentControl Content="{Binding Draft}" Focusable="False" />
                </Border>
            </Grid>

            <!-- Bar tindakan bawah: Kembali, keterangan, satu tindakan utama -->
            <Border Grid.Row="2" MinHeight="64" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,1,0,0" Padding="24,12">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Base}" Command="{Binding BackCommand}"
                            Content="{Binding CurrentPage.BackLabel}"
                            Visibility="{Binding CurrentPage.BackLabel, Converter={StaticResource VisibleWhen}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}"
                            Content="{Binding CurrentPage.Footer.Label}" Command="{Binding CurrentPage.Footer.Command}"
                            ToolTip="{Binding CurrentPage.Footer.Hint}" AutomationProperties.HelpText="{Binding CurrentPage.Footer.Hint}" />
                    <TextBlock Text="{Binding CurrentPage.Footer.Hint}" Style="{StaticResource Text.Caption}" TextAlignment="Right"
                               VerticalAlignment="Center" Margin="12,0" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
