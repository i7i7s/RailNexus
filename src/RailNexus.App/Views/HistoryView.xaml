<UserControl x:Class="RailNexus.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- UI-24 Riwayat dan pemulihan -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="24,20">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource Text.H1}" />
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Caption}" Margin="0,4,0,12"
                       Text="Setiap pekerjaan menyimpan backup sebelum menulis. Undo dijalankan sebagai pekerjaan baru; berkas yang diubah di luar RailNexus tidak ditimpa." />
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Visibility="{Binding EmptyHint, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Text.Caption}" />
            </Border>
            <ListBox Style="{StaticResource List}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                     AutomationProperties.Name="Daftar pekerjaan"
                     Visibility="{Binding Rows.Count, Converter={StaticResource VisibleWhen}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Purpose}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource Text.Caption}">
                                    <Run Text="{Binding KindLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding AssetName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding StartedAt, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <ContentControl Grid.Column="1" Content="{Binding Status}" VerticalAlignment="Center" Focusable="False" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border Grid.Column="1" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="Detail pekerjaan" Style="{StaticResource Text.H2}" />
                    <StackPanel Visibility="{Binding Selected, Converter={StaticResource VisibleWhen}}" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Selected.Purpose}" TextWrapping="Wrap" />
                        <ContentControl Content="{Binding Selected.Status}" Margin="0,8" Focusable="False" />
                        <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding Selected.TxId}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Selected.BackupLabel}" Margin="0,4,0,0" />

                        <TextBlock Text="Berkas" Style="{StaticResource Text.H3}" Margin="0,16,0,4" />
                        <ItemsControl ItemsSource="{Binding Selected.Files}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Text.Caption}">
                                        <Run Text="{Binding Change, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Path, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Tahapan" Style="{StaticResource Text.H3}" Margin="0,16,0,4" />
                        <ItemsControl ItemsSource="{Binding Selected.Steps}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Text.Caption}">
                                        <Run Text="{Binding Time, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" /><Run Text="  " /><Run Text="{Binding Phase, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Note, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Pekerjaan yang terputus: dua pilihan eksplisit. -->
                        <StackPanel Margin="0,16,0,0">
                            <Button Style="{StaticResource Button.Base}" Content="Periksa dan pulihkan (rekonsiliasi)" Command="{Binding ReconcileCommand}"
                                    HorizontalAlignment="Left" />
                            <Button Style="{StaticResource Button.Base}" Content="Batalkan edit tertunda" Command="{Binding DiscardPendingCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0"
                                    ToolTip="Hanya untuk pekerjaan yang submit-nya belum pasti dan aset masih terbuka. Aset kembali ke isi terpasang." />
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Background="{StaticResource Brush.Side}"
                            Visibility="{Binding Outcome, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Text="Hasil" Style="{StaticResource Text.H3}" />
                            <ContentControl Content="{Binding Outcome.Status}" Margin="0,6" Focusable="False" />
                            <TextBlock Text="{Binding Outcome.Message}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Outcome.Details}" Margin="0,6,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
