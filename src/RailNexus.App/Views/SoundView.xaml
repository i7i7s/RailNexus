<UserControl x:Class="RailNexus.App.Views.SoundView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- UI-17 Audio lokal -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">
            <TextBlock Text="Workshop Suara" Style="{StaticResource Text.H1}" />
            <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" Margin="0,4,0,12" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="12">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Small}" Content="Stop" Command="{Binding StopCommand}" />
                    <TextBlock DockPanel.Dock="Left" Text="Volume preview" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <Slider DockPanel.Dock="Left" Width="160" Minimum="0" Maximum="1" Value="{Binding Volume}" VerticalAlignment="Center"
                            AutomationProperties.Name="Volume preview, tidak mengubah aset" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="16,0,0,0" />
                </DockPanel>
            </Border>
            <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Text.Caption}" Visibility="{Binding EmptyHint, Converter={StaticResource VisibleWhen}}" />
            <ItemsControl ItemsSource="{Binding Files}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Path}" FontWeight="SemiBold" FontFamily="{StaticResource Font.Mono}" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding UsedIn}" Style="{StaticResource Text.Caption}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource Button.Small}" Content="Dengarkan" Command="{Binding PlayCommand}" />
                                    <Button Style="{StaticResource Button.Small}" Content="Pilih WAV pengganti…" Margin="8,0" Click="ChooseReplacement_Click" />
                                    <Button Style="{StaticResource Button.Small}" Content="Dengarkan pengganti" Command="{Binding PlayNewCommand}" />
                                </StackPanel>
                                <StackPanel Margin="0,8,0,0" Visibility="{Binding ReplacementPath, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock Text="{Binding ReplacementPath}" Style="{StaticResource Text.Mono}" />
                                    <TextBlock Text="{Binding ReplacementDescription}" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="{Binding Differences}" Foreground="#784C00" TextWrapping="Wrap"
                                               Visibility="{Binding Differences, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Base}" Content="Masukkan penggantian ke draft"
                                            Command="{Binding AddToDraftCommand}" />
                                    <TextBlock Text="{Binding ReplacementProblem}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
