<UserControl x:Class="RailNexus.App.Views.BatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RailNexus.App.Core.ViewModels;assembly=RailNexus.App.Core">
    <!-- UI-22 Batch & preset -->
    <Grid Margin="24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
            <TextBlock Text="Batch &amp; preset" Style="{StaticResource Text.H1}" />
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                       Text="Perubahan dipilih berdasarkan peran dan lokasi, bukan semua token KUID yang sama. Aset diproses satu per satu; batch bukan satu transaksi." />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,16,0">
            <TextBlock DockPanel.Dock="Top" Text="1 · Pilih aset" Style="{StaticResource Text.H3}" Margin="0,0,0,6" />
            <TextBox DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" AutomationProperties.Name="Cari aset untuk batch" />
            <ListBox Style="{StaticResource List}" ItemsSource="{Binding Assets}" Margin="0,8,0,0" AutomationProperties.Name="Aset untuk batch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding KuidText}" Style="{StaticResource Text.Mono}" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="2 · Maksud perubahan" Style="{StaticResource Text.H3}" Margin="0,0,0,6" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Peran" />
                        <ComboBox ItemsSource="{x:Static vm:BatchViewModel.RoleOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding RoleId}" MinHeight="36" Margin="0,4,0,8" AutomationProperties.Name="Peran" />
                        <TextBlock Text="Aset yang diganti (KUID)" />
                        <TextBox Text="{Binding From, UpdateSourceTrigger=PropertyChanged, Delay=300}" Margin="0,4,0,8" AutomationProperties.Name="KUID yang diganti" />
                        <TextBlock Text="Pengganti (KUID)" />
                        <TextBox Text="{Binding To, UpdateSourceTrigger=PropertyChanged, Delay=300}" Margin="0,4,0,8" AutomationProperties.Name="KUID pengganti" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Small}" Content="Simpan preset" Command="{Binding SavePresetCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nama preset" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Presets}" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Button.Chip}" Content="{Binding}"
                                            Command="{Binding DataContext.LoadPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Muat preset" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <DockPanel Margin="0,16,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Small}" Content="Hentikan setelah aset ini" Command="{Binding StopCommand}" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Small}" Content="Tinjau rencana" Command="{Binding PreviewCommand}" />
                    <TextBlock Text="3 · Rencana dan hasil per aset" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding PreviewDisabledReason}" Style="{StaticResource Text.Caption}"
                           Visibility="{Binding PreviewDisabledReason, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,8"
                           Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}" />
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Brush.BorderSoft}" BorderThickness="0,0,0,1" Padding="0,8">
                                <DockPanel>
                                    <ContentControl DockPanel.Dock="Right" Content="{Binding Status}" Focusable="False" VerticalAlignment="Top" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Kuid}" Style="{StaticResource Text.Mono}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
