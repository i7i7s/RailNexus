<UserControl x:Class="RailNexus.App.Views.CargoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- UI-10 Produk & muatan (inspeksi) -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">
            <TextBlock Text="Produk &amp; muatan" Style="{StaticResource Text.H1}" />
            <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" Margin="0,4,0,12" />
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel>
                                    <ContentControl DockPanel.Dock="Right" Content="{Binding Status}" Focusable="False" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H2}" />
                                </DockPanel>
                                <TextBlock Margin="0,6,0,0"><Run Text="Kapasitas: " /><Run Text="{Binding Capacity, Mode=OneWay}" /></TextBlock>
                                <TextBlock><Run Text="Isi awal: " /><Run Text="{Binding Initial, Mode=OneWay}" /></TextBlock>
                                <TextBlock Text="Produk yang diterima" Style="{StaticResource Text.H3}" Margin="0,8,0,2" />
                                <ItemsControl ItemsSource="{Binding Products}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Conflicts}" Margin="0,8,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#A3201A" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Uncertain}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#4B3591" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
