<UserControl x:Class="RailNexus.App.Views.WorkshopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Workshop: peta sembilan utilitas (RN-024, AC-34) -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">
            <TextBlock Text="Workshop" Style="{StaticResource Text.H1}" />
            <TextBlock Text="{Binding Intro}" Style="{StaticResource Text.Caption}" Margin="0,4,0,16" />
            <Border Style="{StaticResource Card}" Padding="0">
                <ItemsControl ItemsSource="{Binding Modules}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Brush.BorderSoft}" BorderThickness="0,0,0,1" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Module}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource Text.Caption}"><Run Text="Kebutuhan: " /><Run Text="{Binding Utility, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0">
                                        <TextBlock Text="{Binding Function}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Stage}" Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                    <ContentControl Grid.Column="2" Content="{Binding Status}" VerticalAlignment="Center" Focusable="False" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,12,0,0"
                       Text="Workshop untuk aset tertentu dibuka dari Pustaka → aset → Mau edit apa?. Workshop Tekstur juga dapat dipakai tanpa Trainz (mode folder)." />
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Base}" Content="Buka Batch &amp; preset" Command="{Binding OpenBatchCommand}" />
                    <StackPanel>
                        <TextBlock Text="Batch &amp; preset" Style="{StaticResource Text.H2}" />
                        <TextBlock Text="{Binding BatchHint}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
