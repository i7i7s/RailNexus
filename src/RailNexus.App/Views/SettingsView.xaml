<UserControl x:Class="RailNexus.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- UI-25 Pengaturan -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Pengaturan" Style="{StaticResource Text.H1}" />

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Instalasi Trainz" Style="{StaticResource Text.H2}" />
                    <TextBlock Text="{Binding Installation}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding TrainzFolder}" Style="{StaticResource Text.Mono}" Margin="0,2,0,0" />
                    <Button Style="{StaticResource Button.Small}" Content="Ganti instalasi atau sambungkan ulang" Margin="0,12,0,0"
                            HorizontalAlignment="Left" Command="{Binding ChangeInstallationCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Aset uji yang boleh ditulis" Style="{StaticResource Text.H2}" />
                    <TextBlock Text="{Binding WriteNote}" Style="{StaticResource Text.Caption}" Margin="0,4,0,12" />
                    <ItemsControl ItemsSource="{Binding TestKuids}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Hapus" Command="{Binding RemoveCommand}"
                                            AutomationProperties.Name="Hapus KUID dari daftar" />
                                    <TextBlock Text="{Binding Kuid}" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="KUID aset uji" Style="{StaticResource Text.H3}" Margin="0,8,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Base}" Content="Tambahkan" Margin="8,0,0,0"
                                Command="{Binding AddKuidCommand}" />
                        <TextBox Text="{Binding NewKuid, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="KUID aset uji" />
                    </DockPanel>
                    <TextBlock Text="{Binding KuidError}" Foreground="#A3201A" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding KuidError, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Data, riwayat, dan backup" Style="{StaticResource Text.H2}" />
                    <TextBlock Text="{Binding BackupSummary}" Style="{StaticResource Text.Caption}" Margin="0,4,0,8" />
                    <TextBlock Style="{StaticResource Text.Caption}"><Run Text="Folder data: " /><Run Text="{Binding DataRoot, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" /></TextBlock>
                    <TextBlock Style="{StaticResource Text.Caption}"><Run Text="Berkas pengaturan: " /><Run Text="{Binding SettingsPath, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" /></TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Kemampuan profil build" Style="{StaticResource Text.H2}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,8"
                               Text="Operasi tulis hanya berjalan bila terverifikasi dengan keluaran nyata pada build ini." />
                    <ItemsControl ItemsSource="{Binding Capabilities}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Operation}" VerticalAlignment="Center" />
                                    <ContentControl Grid.Column="1" Content="{Binding Status}" Focusable="False" />
                                    <TextBlock Grid.Column="2" Text="{Binding Evidence}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Bahasa dan tampilan" Style="{StaticResource Text.H2}" />
                    <TextBlock Text="{Binding Language}" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="Ukuran teks mengikuti pengaturan skala Windows. Font IBM Plex Sans dipakai bila terpasang." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
