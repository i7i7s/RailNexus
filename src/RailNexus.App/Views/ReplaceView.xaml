<UserControl x:Class="RailNexus.App.Views.ReplaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bentuk minimal UI-04/05/07/08: pilih lokasi → cari pengganti lokal → tambahkan ke draft. -->
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{Binding CommunityTerm}" Style="{StaticResource Text.Mono}" VerticalAlignment="Bottom" Margin="10,0,0,4" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                       Text="Hanya lokasi yang dipilih yang diganti. Kondisi, orientasi, dan nama di kuid-table dipertahankan." />
        </StackPanel>

        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
            <TextBlock DockPanel.Dock="Top" Text="Lokasi" Style="{StaticResource Text.H3}" Margin="0,0,0,8" />
            <ListBox Style="{StaticResource List}" ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}"
                     AutomationProperties.Name="Lokasi yang dapat diganti">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Text.Caption}">
                                <Run Text="Sekarang: " /><Run Text="{Binding Current, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding CurrentKuid}" Style="{StaticResource Text.Mono}" />
                            <TextBlock Text="{Binding Context}" Style="{StaticResource Text.Caption}"
                                       Visibility="{Binding Context, Converter={StaticResource VisibleWhen}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="Cari pengganti di pustaka lokal" Style="{StaticResource Text.H3}" Margin="0,0,0,8" />
            <TextBox DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                     AutomationProperties.Name="Cari pengganti berdasarkan nama atau KUID" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyHint}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                       Visibility="{Binding EmptyHint, Converter={StaticResource VisibleWhen}}" />
            <DockPanel DockPanel.Dock="Top" Margin="0,8,0,0" Visibility="{Binding Candidates.Count, Converter={StaticResource VisibleWhen}}">
                <Button DockPanel.Dock="Left" Style="{StaticResource Button.Small}" Content="Baca jenis kandidat" Command="{Binding ReadKindsCommand}"
                        ToolTip="Membaca KIND dari config kandidat agar kecocokan dapat dipastikan" />
                <TextBlock Text="{Binding KindStatus}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </DockPanel>
            <ListBox Style="{StaticResource List}" Margin="0,8,0,0" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}"
                     AutomationProperties.Name="Kandidat pengganti"
                     Visibility="{Binding Candidates.Count, Converter={StaticResource VisibleWhen}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding KuidText}" Style="{StaticResource Text.Mono}" />
                                <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <ContentControl Content="{Binding Verdict}" Focusable="False" />
                                <ContentControl Content="{Binding AssetStatus}" Margin="0,4,0,0" Focusable="False" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Base}" Content="Gunakan pengganti ini" Command="{Binding AddCommand}"
                    ToolTip="{Binding AddDisabledReason}" />
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding AddDisabledReason}" Style="{StaticResource Text.Caption}" TextAlignment="Right" />
                <TextBlock Text="{Binding Error}" Foreground="#A3201A" TextWrapping="Wrap" TextAlignment="Right"
                           Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
