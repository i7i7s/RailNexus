<UserControl x:Class="RailNexus.App.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- UI-01 Sambungkan Trainz -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">
                <TextBlock Text="Instalasi yang ditemukan" Style="{StaticResource Text.H1}" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,16"
                           Text="RailNexus memeriksa lokasi instalasi yang umum. Pilih satu; semua perubahan nanti hanya berlaku di profil yang Anda pilih." />

                <TextBlock Text="Instalasi" Style="{StaticResource Text.H3}" Margin="0,0,0,8" />
                <ListBox Style="{StaticResource List}" ItemsSource="{Binding Installations}" SelectedItem="{Binding Selected}"
                         AutomationProperties.Name="Instalasi Trainz">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ContentControl Content="{Binding ToolStatus}" Margin="8,0,0,0" Focusable="False" />
                                </StackPanel>
                                <TextBlock Text="{Binding Folder}" Style="{StaticResource Text.Mono}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                           Text="Belum ada instalasi di daftar? Pilih folder yang berisi TrainzUtil.exe."
                           Visibility="{Binding Installations.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource Button.Base}" Content="Pilih folder instalasi lain…" Click="PickFolder_Click" />
                    <Button Style="{StaticResource Button.Base}" Content="Periksa koneksi" Margin="8,0,0,0" Command="{Binding CheckCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0">
            <StackPanel Margin="20">
                <TextBlock Text="Pemeriksaan koneksi" Style="{StaticResource Text.H2}" />
                <ContentControl Content="{Binding Status}" Margin="0,12" Focusable="False" />
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Brush.BorderSoft}" BorderThickness="0,0,0,1" Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Ikon hanya pendukung; status dibaca dari judul langkah. -->
                                    <TextBlock x:Name="Mark" Text="✓" Foreground="#17603A" FontWeight="Bold" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Ok}" Value="False">
                                    <Setter TargetName="Mark" Property="Text" Value="!" />
                                    <Setter TargetName="Mark" Property="Foreground" Value="#784C00" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,16,0,0"
                           Text="RailNexus tidak meminta akun atau password Trainz. Trainz perlu berjalan dengan Advanced Debug Tools aktif." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
