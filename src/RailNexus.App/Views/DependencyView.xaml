<UserControl x:Class="RailNexus.App.Views.DependencyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- UI-04 inventaris: komponen & dependency per peran -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">
            <TextBlock Text="Komponen &amp; dependency" Style="{StaticResource Text.H1}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" Margin="0,4,0,12" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding Unavailable, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="{Binding Unavailable}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Brush.BorderSoft}" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Role}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Location}" Style="{StaticResource Text.Mono}" />
                                        <TextBlock Style="{StaticResource Text.Caption}" Visibility="{Binding SymbolicName, Converter={StaticResource VisibleWhen}}">
                                            <Run Text="Nama simbolik: " /><Run Text="{Binding SymbolicName, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0">
                                        <TextBlock Text="{Binding TargetName}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TargetKuid}" Style="{StaticResource Text.Mono}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <ContentControl Content="{Binding Status}" Focusable="False" />
                                            <ContentControl Content="{Binding Support}" Margin="6,0,0,0" Focusable="False" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Button.Small}" Content="Ganti" Command="{Binding Replace}" Margin="0,0,0,6"
                                                Visibility="{Binding Replace, Converter={StaticResource VisibleWhen}}" />
                                        <Button Style="{StaticResource Button.Small}" Content="Buka aset" Command="{Binding OpenTarget}"
                                                Visibility="{Binding OpenTarget, Converter={StaticResource VisibleWhen}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <DockPanel Margin="0,20,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Small}" Content="Baca dependency turunan" Command="{Binding ReadTransitiveCommand}" />
                <StackPanel>
                    <TextBlock Text="Dependency turunan" Style="{StaticResource Text.H2}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="Dimuat bertahap sampai kedalaman 3; siklus ditandai dan tidak diulang." />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" Margin="0,0,0,8"
                       Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}" />
            <ItemsControl ItemsSource="{Binding Graph}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Border Width="{Binding Indent}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Kuid}" Style="{StaticResource Text.Mono}" Margin="8,0" VerticalAlignment="Center" />
                            <ContentControl Content="{Binding Status}" Focusable="False" />
                            <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
